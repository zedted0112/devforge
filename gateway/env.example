# Server Configuration
NODE_ENV=development
PORT=3000

# Docker Configuration
DOCKER=false

# Service URLs (for Railway communication)
# Use external Railway URLs for reliable service-to-service communication
# Internal URLs (http://auth-service:3001) don't work reliably in Railway
# These external URLs are automatically provided by Railway and are more stable
AUTH_SERVICE_URL=https://devforge-auth-production.up.railway.app
PROJECT_SERVICE_URL=https://devforge-project-service-production.up.railway.app

# Frontend URL for CORS
FRONTEND_URL=https://devforge-zeta.vercel.app 