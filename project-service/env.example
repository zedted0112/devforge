# Server Configuration
NODE_ENV=development
PORT=3002

# Database Configuration
DATABASE_URL=postgresql://devforge_user:devforge_password@localhost:5432/devforge

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Security
CORS_ORIGIN=http://localhost:5173

# Service Communication (for Railway production)
# Use external Railway URLs for reliable service-to-service communication
# Internal URLs (http://auth-service.railway.internal:3001) don't work reliably in Railway
AUTH_SERVICE_URL=https://devforge-auth-production.up.railway.app 